{
  "name": "wordofmodel",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "copycheck": "node scripts/copycheck.mjs",
    "check": "npm run typecheck && npm run copycheck",
    "smoke": "node --env-file=.env.local scripts/smoke.mjs",
    "stripe:setup": "node --env-file=.env.local scripts/stripe-setup.mjs",
    "bakeoff": "node --env-file=.env.local scripts/serp-bakeoff.mjs",
    "extract:check": "node --env-file=.env.local --conditions=react-server --import ./scripts/ts-register.mjs scripts/extract-check.mjs",
    "alerts": "node --env-file=.env.local --conditions=react-server --import ./scripts/ts-register.mjs scripts/alerts-check.mjs",
    "founding:race": "node --env-file=.env.local --conditions=react-server --import ./scripts/ts-register.mjs scripts/founding-race.mjs",
    "checkout:check": "node --env-file=.env.local --conditions=react-server --import ./scripts/ts-register.mjs scripts/checkout-check.mjs",
    "noise": "node --env-file=.env.local --conditions=react-server --import ./scripts/ts-register.mjs scripts/noise-floor.mjs",
    "funnel": "node --env-file=.env.local --conditions=react-server --import ./scripts/ts-register.mjs scripts/funnel.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.20.0",
    "server-only": "^0.0.1",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^7.0.2"
  }
}
