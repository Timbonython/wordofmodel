{
  "name": "wordofmodel",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "copycheck": "node scripts/copycheck.mjs",
    "brandcheck": "node --conditions=react-server --import ./scripts/ts-register.mjs scripts/brandcheck.mjs",
    "check": "npm run typecheck && npm run copycheck && npm run brandcheck && npm run verdict:check && npm run locations:check",
    "smoke": "node --env-file=.env.local scripts/smoke.mjs",
    "stripe:setup": "node --env-file=.env.local --conditions=react-server --import ./scripts/ts-register.mjs scripts/stripe-setup.mjs",
    "stripe:mode": "node --env-file=.env.local --conditions=react-server --import ./scripts/ts-register.mjs scripts/stripe-mode-check.mjs",
    "founding:cap": "node --env-file=.env.local --conditions=react-server --import ./scripts/ts-register.mjs scripts/founding-cap-check.mjs",
    "verdict:check": "node --conditions=react-server --import ./scripts/ts-register.mjs scripts/verdict-check.mjs",
    "locations:check": "node --conditions=react-server --import ./scripts/ts-register.mjs scripts/locations-check.mjs",
    "price:verify": "node --env-file=.env.local --conditions=react-server --import ./scripts/ts-register.mjs scripts/price-verify.mjs",
    "bakeoff": "node --env-file=.env.local scripts/serp-bakeoff.mjs",
    "extract:check": "node --env-file=.env.local --conditions=react-server --import ./scripts/ts-register.mjs scripts/extract-check.mjs",
    "alerts": "node --env-file=.env.local --conditions=react-server --import ./scripts/ts-register.mjs scripts/alerts-check.mjs",
    "founding:race": "node --env-file=.env.local --conditions=react-server --import ./scripts/ts-register.mjs scripts/founding-race.mjs",
    "checkout:check": "node --env-file=.env.local --conditions=react-server --import ./scripts/ts-register.mjs scripts/checkout-check.mjs",
    "noise": "node --env-file=.env.local --conditions=react-server --import ./scripts/ts-register.mjs scripts/noise-floor.mjs",
    "funnel": "node --env-file=.env.local --conditions=react-server --import ./scripts/ts-register.mjs scripts/funnel.mjs",
    "requeue": "node --env-file=.env.local --conditions=react-server --import ./scripts/ts-register.mjs scripts/requeue-capture.mjs",
    "trial:setup": "node --env-file=.env.local --conditions=react-server --import ./scripts/ts-register.mjs scripts/founding-trial-setup.mjs",
    "discount:setup": "node --env-file=.env.local --conditions=react-server --import ./scripts/ts-register.mjs scripts/discount-setup.mjs",
    "favicon": "node scripts/make-favicon.mjs",
    "pixel:check": "node scripts/pixel-check.mjs",
    "pixel": "node scripts/pixel-probe.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.20.0",
    "server-only": "^0.0.1",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^7.0.2"
  }
}
