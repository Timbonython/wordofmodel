# Copy to .env.local. Never commit the filled in version: .env* is gitignored.
# The same set goes in Vercel -> Project -> Settings -> Environment Variables.

OPENAI_API_KEY=sk-...
PERPLEXITY_API_KEY=pplx-...

# Server side only. The secret key bypasses RLS, which is what makes the
# no-policy setup in supabase/migrations/0001_init.sql work. It must never be
# exposed to a browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Used only by the server side auth client in lib/auth.ts, which is what makes the
# magic link work. It is RLS bound and safe to expose, but nothing in this build
# talks to Supabase from a browser, so it is deliberately not NEXT_PUBLIC_.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

RESEND_API_KEY=re_...
RESEND_FROM="Word of Model <results@wordofmodel.ai>"
RESEND_REPLY_TO=hello@wordofmodel.ai

# Optional -------------------------------------------------------------------

# Salt for hashing visitor IPs. Set this in production. Falls back to the
# Supabase secret, so a missing value is never a plaintext address.
# IP_HASH_SALT=

# Production only. Deliberately NOT set on Preview: with no value there,
# lib/env.ts derives the base URL from VERCEL_URL, so a preview deploy's Stripe
# redirects and magic links come back to the deploy that is actually running
# rather than to the live site. Unset locally gives http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://wordofmodel.ai

# Model overrides, so a bad model release can be rolled back without a deploy.
# Defaults are set in lib/env.ts and were verified against both live APIs.
# OPENAI_MODEL_ANSWER=gpt-5.5
# OPENAI_MODEL_UTILITY=gpt-5.4-mini
# PERPLEXITY_MODEL=perplexity/sonar

# Stripe. Test mode for this build: STRIPE_MODE guards it, and lib/stripe.ts
# refuses to start on a mismatch between the mode and the key prefix.
STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_...

# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally,
# or from the endpoint's signing secret in the dashboard.
STRIPE_WEBHOOK_SECRET=whsec_...

# Created by `npm run stripe:setup`, which prints these. Pinned by id rather
# than looked up by key at runtime, so a price cannot be swapped underneath a
# live checkout.
STRIPE_PRICE_FOUNDING_MONTHLY=price_...
STRIPE_PRICE_STANDARD_MONTHLY=price_...

# Optional. Without it Stripe falls back to the account default portal
# configuration, which has plan switching on, and plan switching off a founding
# price is the one thing the portal must not allow.
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_...

# Where failed payments get reported. Without it a failed payment only reaches
# the server log, which is revenue leaking quietly.
ALERT_EMAIL=hello@wordofmodel.ai
